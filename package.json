  "repository": {
    "type": "git",
    "url": "git+https://github.com/6can/discord-lol-rpc.git"
  },
  "homepage": "https://github.com/6can/discord-lol-rpc#readme",
  "bugs": {
    "url": "https://github.com/6can/discord-lol-rpc/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ]
}
